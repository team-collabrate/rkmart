{
  "name": "rkmart",
  "private": true,
  "version": "0.0.0",
  "description": "RK Grocery: wholesale ordering, GST billing and payment tracking",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "lint": "npm run lint -w apps/web",
    "typecheck": "npm run typecheck -w apps/web",
    "test": "npm run test -w apps/web",
    "test:db": "vitest run --config supabase/tests/vitest.config.mts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "npm run e2e -w apps/web"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@supabase/supabase-js": "^2.119.0",
    "prettier": "^3.6.2",
    "vitest": "^5.1.0"
  }
}
