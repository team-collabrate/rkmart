# Copy to .env.local and fill in. Never commit real values.
# Only the PUBLIC anon key belongs in the app. The Supabase service-role key must never be put here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# "1" adds the Stage 0 spike pages to a production build. Leave empty for real releases.
VITE_SPIKES=
